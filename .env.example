# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=E-commerce

# User reader dành cho SQL Agent (chỉ đọc)
POSTGRES_USER=vietreport_reader
POSTGRES_PASSWORD=vietreport_reader_password

# User admin dành cho script tạo / nạp dữ liệu (db/generate_data.py)
POSTGRES_ADMIN_USER=vietreport_admin
POSTGRES_ADMIN_PASSWORD=vietreport_admin_password

# ==============================================================================
# LLM API Keys (Groq / OpenAI / Gemini / etc.)
# ==============================================================================
# API keys là secret; endpoint, model và tham số nằm trong configs/models.yaml.
BASELINE_API_KEY=
SQL_AGENT_API_KEY=
PLANNER_API_KEY=
ANALYTICS_API_KEY=
WRITER_API_KEY=
VERIFIER_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
SQL_TIMEOUT_MS=10000
SQL_MAX_ROWS=1000
